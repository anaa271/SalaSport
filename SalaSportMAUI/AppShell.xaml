<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SalaSportMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SalaSportMAUI.Views">

    <TabBar>

        <ShellContent
            Title="Appointments"
            ContentTemplate="{DataTemplate views:AppointmentsPage}" />

        <ShellContent
            Title="Subscription"
            ContentTemplate="{DataTemplate views:SubscriptionPage}" />

        <ShellContent
            Title="Trainers"
            ContentTemplate="{DataTemplate views:TrainersPage}" />

    </TabBar>

</Shell>
