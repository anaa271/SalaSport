<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SalaSportMAUI.Views.SubscriptionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Subscriptions">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Member subscriptions"
               FontAttributes="Bold"
               FontSize="20" />

        <CollectionView ItemsSource="{Binding Subscriptions}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,6" CornerRadius="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="16" />

                            <Label Text="{Binding Price, StringFormat='Price: {0}'}" />
                            <Label Text="{Binding StartDate, StringFormat='From: {0:dd.MM.yyyy}'}" />
                            <Label Text="{Binding EndDate, StringFormat='To: {0:dd.MM.yyyy}'}" />

                            <Label Text="{Binding IsActive, StringFormat='Active: {0}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
