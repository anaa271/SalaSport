<ContentPage
    x:Class="SalaSportMAUI.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:beh="clr-namespace:SalaSportMAUI.Behaviours"
    Title="Appointments">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="My Appointments"
                FontSize="22"
                HorizontalOptions="Center" />

            <!-- IMPORTANT: height ca să nu se bată scroll-ul CollectionView cu ScrollView -->
            <CollectionView ItemsSource="{Binding Appointments}"
                            SelectionMode="Single"
                            SelectionChanged="OnAppointmentSelected"
                            HeightRequest="280">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10" Padding="10" BackgroundColor="#1E1E1E">
                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding AppointmentId, StringFormat='Appointment #{0}'}"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="{Binding StartTime, StringFormat='Start: {0:dd.MM.yyyy HH:mm}'}"
                                    TextColor="LightGray" />

                                <Label
                                    Text="{Binding EndTime, StringFormat='End: {0:dd.MM.yyyy HH:mm}'}"
                                    TextColor="LightGray" />

                                <Label
                                    Text="{Binding Status, StringFormat='Status: {0}'}"
                                    TextColor="LightGray" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Entry
                x:Name="TrainerIdEntry"
                Placeholder="Trainer ID"
                Keyboard="Numeric" />

            <Entry
                x:Name="NotesEntry"
                Placeholder="Notes" />

            <Label Text="Start date" />
            <DatePicker x:Name="StartDatePicker" />

            <Label Text="Start time" />
            <TimePicker x:Name="StartTimePicker" />

            <Label Text="Duration (minutes)" />
            <Picker x:Name="DurationPicker" Title="Duration">
                <Picker.Items>
                    <x:String>30</x:String>
                    <x:String>60</x:String>
                    <x:String>90</x:String>
                    <x:String>120</x:String>
                </Picker.Items>
            </Picker>

            <Button
                Text="Add Appointment"
                Clicked="OnAddAppointmentClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
