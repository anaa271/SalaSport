@page
@model SalaSport.Pages.My.SubscriptionsModel
@{
    ViewData["Title"] = "My Subscriptions";
}

<h1>My Subscriptions</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="text-danger">@Model.ErrorMessage</div>
}
else if (Model.Items.Count == 0)
{
    <p>No subscriptions found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subscription</th>
                <th>Months</th>
                <th>Price</th>
                <th>From</th>
                <th>To</th>
                <th>IsActive (flag)</th>
                <th>Active now</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Items)
            {
                <tr>
                    <td>@s.SubscriptionName</td>
                    <td>@s.Months</td>
                    <td>@s.Price</td>
                    <td>@s.StartDate.ToString("dd.MM.yyyy")</td>
                    <td>@s.EndDate.ToString("dd.MM.yyyy")</td>
                    <td>@s.IsActiveFlag</td>
                    <td>
                        @if (s.ActiveNow)
                        {
                            <span class="badge bg-success">ACTIVE</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">INACTIVE</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
