@page
@model SalaSport.Pages.My.AppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
}

<h1>My Appointments</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="text-danger">@Model.ErrorMessage</div>
}

<h3>Create appointment</h3>

<form method="post" class="mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.TrainerId" class="form-label"></label>
        <select asp-for="Input.TrainerId" class="form-control" asp-items="Model.TrainerOptions">
            <option value="">-- Select trainer --</option>
        </select>
        <span asp-validation-for="Input.TrainerId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Date" class="form-label"></label>
        <input asp-for="Input.Date" class="form-control" />
        <span asp-validation-for="Input.Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Time" class="form-label"></label>
        <input asp-for="Input.Time" class="form-control" />
        <span asp-validation-for="Input.Time" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.DurationMinutes" class="form-label"></label>
        <input asp-for="Input.DurationMinutes" class="form-control" />
        <span asp-validation-for="Input.DurationMinutes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Notes" class="form-label"></label>
        <input asp-for="Input.Notes" class="form-control" />
        <span asp-validation-for="Input.Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<h3>My appointments list</h3>

@if (Model.Appointments.Count == 0)
{
    <p>No appointments found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Appointments)
            {
                <tr>
                    <td>@a.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@a.Status</td>
                    <td>@a.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
