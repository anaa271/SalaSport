@page
@model SalaSport.Pages.Appointments.CreateModel
@using SalaSport.Models

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Appointment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Appointment.MemberId" class="control-label"></label>
                <select asp-for="Appointment.MemberId"
                        class="form-control"
                        asp-items="ViewBag.MemberId"
                        aria-required="true"></select>
                <span asp-validation-for="Appointment.MemberId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Appointment.TrainerId" class="control-label"></label>
                <select asp-for="Appointment.TrainerId"
                        class="form-control"
                        asp-items="ViewBag.TrainerId"
                        aria-required="true"></select>
                <span asp-validation-for="Appointment.TrainerId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Appointment.StartTime" class="control-label"></label>
                <input asp-for="Appointment.StartTime" class="form-control" aria-required="true" />
                <span asp-validation-for="Appointment.StartTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Appointment.EndTime" class="control-label"></label>
                <input asp-for="Appointment.EndTime" class="form-control" aria-required="true" />
                <span asp-validation-for="Appointment.EndTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Appointment.Status" class="control-label"></label>
                <select asp-for="Appointment.Status"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<AppointmentStatus>()">
                </select>
                <span asp-validation-for="Appointment.Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Appointment.Notes" class="control-label"></label>
                <input asp-for="Appointment.Notes" class="form-control" />
                <span asp-validation-for="Appointment.Notes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
