@page
@model SalaSport.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Type</th>
            <th>Amount</th>
            <th>PaidAt</th>
            <th>Reference</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Payments)
        {
            <tr>
                <td>@(p.Member?.FullName ?? p.MemberId.ToString())</td>
                <td>@p.ForType</td>
                <td>@p.Amount</td>
                <td>@p.PaidAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @if (p.AppointmentId != null)
                    {
                        <span>Appointment #@p.AppointmentId</span>
                    }
                    else if (p.MemberSubscriptionId != null)
                    {
                        <span>Subscription: @p.MemberSubscription?.Subscription?.Name</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    <a asp-page="./Details" asp-route-id="@p.PaymentId">Details</a> |
                    <a asp-page="./Edit" asp-route-id="@p.PaymentId">Edit</a> |
                    <a asp-page="./Delete" asp-route-id="@p.PaymentId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
