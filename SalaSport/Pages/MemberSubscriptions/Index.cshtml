@page
@model SalaSport.Pages.MemberSubscriptions.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Member Subscriptions</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MemberSubscription[0].Member)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberSubscription[0].Subscription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberSubscription[0].StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberSubscription[0].EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberSubscription[0].IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.MemberSubscription) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Member.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Subscription.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.MemberSubscriptionId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.MemberSubscriptionId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.MemberSubscriptionId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
