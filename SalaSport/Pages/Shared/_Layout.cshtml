<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalaSport</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SalaSport.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">SalaSport</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">

                        <!-- Visible for everyone -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Trainers/Index">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Subscriptions/Index">Subscriptions</a>
                        </li>

                        @* When authenticated, show menu based on role *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* MEMBER (User) *@
                            if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/My/Appointments">My Appointments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/My/Subscriptions">My Subscriptions</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/My/Payments">My Payments</a>
                                </li>
                            }

                            @* ADMIN *@
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Members/Index">Members</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/MemberSubscriptions/Index">Member Subscriptions</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Appointments/Index">Appointments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Payments/Index">Payments</a>
                                </li>
                            }

                            @* (Optional) Trainer role: decide ce vrei să vadă trainerul *@
                            if (User.IsInRole("Trainer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-page="/Appointments/Index">Appointments</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <partial name="_LoginPartial" />
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SalaSport - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
